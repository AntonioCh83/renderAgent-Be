# Chiavi API
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Server
PORT=3000
# Origini FE ammesse (separate da virgola)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Impostare a 1 se il BE gira dietro un proxy (es. hosting cloud), per il rate limiting corretto
TRUST_PROXY=

# Modelli
OPENAI_MODEL=gpt-4o-mini
# Anteprime veloci: black-forest-labs/flux-schnell — qualità superiore: black-forest-labs/flux-1.1-pro
RENDER_MODEL=black-forest-labs/flux-schnell
RENDER_VARIANTS=2
MAX_RENDERS_PER_DESIGN=12

# Brand di chi espone l'app
COMPANY_NAME=Casa Futuro
ASSISTANT_NAME=Lia
CONTACT_EMAIL=preventivi@example.com
